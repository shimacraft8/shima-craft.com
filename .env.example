# 本番サイトのURL（OGP・sitemap・robots・canonical に使用）
NEXT_PUBLIC_SITE_URL=https://shima-craft.com

# Google Analytics 4 の測定ID（例：G-XXXXXXXXXX）
# 未設定の場合は GA のスクリプトを読み込みません
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────
# Web導線チェック フォーム メール送信設定（Resend）
# ─────────────────────────────────────────────────
# Resend API キー（https://resend.com でアカウント作成後に取得）
# 未設定の場合、フォーム送信は 503 エラーとなります（偽装送信なし）
RESEND_API_KEY=

# 送信元メールアドレス
# Resend の無料プラン：onboarding@resend.dev から登録済みアドレスへの送信が可能（テスト用）
# 本番利用には独自ドメインの認証が必要（例: noreply@shima-craft.com）
RESEND_FROM=onboarding@resend.dev
