# 本番サイトのURL（OGP・sitemap・robots・canonical・認証メールのリンクに使用）
NEXT_PUBLIC_SITE_URL=https://shima-craft.com

# Google Analytics 4 の測定ID（例：G-XXXXXXXXXX）
# 未設定の場合は GA のスクリプトを読み込みません
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────
# Web導線チェック フォーム メール送信設定（Resend）
# ─────────────────────────────────────────────────
# Resend API キー（https://resend.com でアカウント作成後に取得）
# 未設定の場合、フォーム送信は 503 エラーとなります（偽装送信なし）
RESEND_API_KEY=

# 送信元メールアドレス
RESEND_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────────
# 白黒写真カラー化サービス（/tools/photo-colorize）会員制
# ─────────────────────────────────────────────────

# Supabase プロジェクトのURL・キー（Supabaseダッシュボード → Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key（server-only。NEXT_PUBLIC_ を付けない・クライアントへ出さない）
SUPABASE_SERVICE_ROLE_KEY=

# 初期管理者のメールアドレス（scripts/create-initial-admin.mjs で使用。コード直書き禁止）
INITIAL_ADMIN_EMAIL=

# 任意: 管理画面アクセスの追加allowlist（カンマ区切りメール。単独の認可根拠にはならない）
ADMIN_EMAIL_ALLOWLIST=

# 任意: 未会員お試しの成功回数上限（既定 3）
TRIAL_FREE_LIMIT=
# 任意: IPあたりのお試し成功回数上限（既定 3）
TRIAL_IP_LIMIT=
# 任意: お試しチケット署名用シークレット（未設定時はService Role Keyから導出）
TRIAL_TICKET_SECRET=
# 任意: 監査ログ・お試しのIPハッシュ用ソルト
LOG_IP_HASH_SALT=

# カラー化機能全体の有効/無効フラグ。"false" で「提供一時停止」表示になります（緊急停止用）
COLORIZE_ENABLED=true

# ─────────────────────────────────────────────────
# 廃止済み（コード参照なし。Vercelに残っていれば削除可）:
#   REPLICATE_API_TOKEN / REPLICATE_DDCOLOR_VERSION
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY
#   COLORIZE_DAILY_LIMIT / COLORIZE_MAX_BYTES
#   COLORIZE_GLOBAL_DAILY_LIMIT / COLORIZE_RATE_LIMIT_SALT
# ─────────────────────────────────────────────────
