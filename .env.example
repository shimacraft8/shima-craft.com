# 本番サイトのURL（OGP・sitemap・robots・canonical に使用）
NEXT_PUBLIC_SITE_URL=https://shima-craft.com

# Google Analytics 4 の測定ID（例：G-XXXXXXXXXX）
# 未設定の場合は GA のスクリプトを読み込みません
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────
# Web導線チェック フォーム メール送信設定（Resend）
# ─────────────────────────────────────────────────
# Resend API キー（https://resend.com でアカウント作成後に取得）
# 未設定の場合、フォーム送信は 503 エラーとなります（偽装送信なし）
RESEND_API_KEY=

# 送信元メールアドレス
# Resend の無料プラン：onboarding@resend.dev から登録済みアドレスへの送信が可能（テスト用）
# 本番利用には独自ドメインの認証が必要（例: noreply@shima-craft.com）
RESEND_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────────
# 白黒写真カラー化ツール（/tools/photo-colorize）
# ─────────────────────────────────────────────────

# Replicate APIトークン（https://replicate.com/account/api-tokens で取得）server-only
# 未設定の場合、カラー化APIは SERVICE_DISABLED を返します（偽装実行なし）
REPLICATE_API_TOKEN=

# DDColor (piddnad/ddcolor) のバージョンID固定用。未設定時はコード内の既定バージョンを使用します。
# 参照: https://replicate.com/piddnad/ddcolor/versions
REPLICATE_DDCOLOR_VERSION=

# Cloudflare Turnstile サイトキー（クライアント公開・NEXT_PUBLIC_）
# 開発時はCloudflare公式のテストキー「常に成功」1x00000000000000000000AA が利用できます
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile シークレットキー server-only
# 開発時はCloudflare公式のテストシークレット「常に成功」1x0000000000000000000000000000000AA が利用できます
# 未設定の場合、カラー化APIは常に失敗します（無防備な実行を許可しない）
TURNSTILE_SECRET_KEY=

# カラー化機能全体の有効/無効フラグ。"false" を設定すると即座に停止できます（ロールバック用）
COLORIZE_ENABLED=true

# 1 IP・1日あたりの利用回数上限（インメモリ実装のため、複数サーバーインスタンス間では厳密ではありません）
COLORIZE_DAILY_LIMIT=5

# サーバーが受け付ける画像の最大バイト数（既定 4,000,000 = 4MB未満）
COLORIZE_MAX_BYTES=4000000

# 任意：1日あたりの全体利用回数上限（費用暴走防止用。未設定の場合は上限なし）
COLORIZE_GLOBAL_DAILY_LIMIT=

# 任意：レート制限のIPハッシュ化に使うソルト文字列（未設定時は既定値を使用）
COLORIZE_RATE_LIMIT_SALT=
