# 本番サイトのURL（OGP・sitemap・robots・canonical・招待メールのリンクに使用）
NEXT_PUBLIC_SITE_URL=https://shima-craft.com

# Google Analytics 4 の測定ID（例：G-XXXXXXXXXX）
# 未設定の場合は GA のスクリプトを読み込みません
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────
# Web導線チェック フォーム / 招待メール送信（Resend）
# ─────────────────────────────────────────────────
# Resend API キー（https://resend.com でアカウント作成後に取得）server-only
RESEND_API_KEY=
# 送信元メールアドレス（本番は独自ドメインの認証済みアドレス推奨）
RESEND_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────────
# 白黒写真カラー化サービス（会員制・Firebase）
# ─────────────────────────────────────────────────

# Firebase Web SDK（公開設定・クライアントで使用）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin SDK（server-only。NEXT_PUBLIC_ を付けない・クライアントへ出さない）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 秘密鍵。改行を含むため "..." で囲み \n をそのまま貼り付け可（コードが復元します）
FIREBASE_PRIVATE_KEY=

# セッションCookie名（任意・既定 sc_session）
FIREBASE_SESSION_COOKIE_NAME=sc_session

# 初期管理者のメールアドレス（Google verified emailと完全一致した場合のみadmin化）
INITIAL_ADMIN_EMAIL=

# 任意: 管理画面アクセスの追加allowlist（カンマ区切りメール。単独の認可根拠にはならない）
ADMIN_EMAIL_ALLOWLIST=

# 任意: 招待トークン署名用シークレット（未設定時はサービスアカウント鍵から導出）
INVITATION_TOKEN_SECRET=
# 任意: 監査ログのIPハッシュ用ソルト
LOG_IP_HASH_SALT=

# カラー化機能全体の有効/無効フラグ。"false" で「提供一時停止」表示（緊急停止用）
COLORIZE_ENABLED=true

# Groq API キー（server-only。NEXT_PUBLIC_ を付けない）
# 会員向け Groq Vision（Llama 4 Scout）色ヒント機能で使用。未設定時はヒントなし（ONNX のみ）で動作
# 取得先: https://console.groq.com/keys（無料・クレジットカード不要）
GROQ_API_KEY=

# ─────────────────────────────────────────────────
# 廃止済み（コード参照なし。Vercelに残っていれば削除可）:
#   GOOGLE_AI_API_KEY
#   REPLICATE_API_TOKEN / REPLICATE_DDCOLOR_VERSION
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY
#   COLORIZE_DAILY_LIMIT / COLORIZE_MAX_BYTES
#   COLORIZE_GLOBAL_DAILY_LIMIT / COLORIZE_RATE_LIMIT_SALT
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   TRIAL_FREE_LIMIT / TRIAL_IP_LIMIT / TRIAL_TICKET_SECRET
# ─────────────────────────────────────────────────
