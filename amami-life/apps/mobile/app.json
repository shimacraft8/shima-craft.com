{
  "expo": {
    "name": "AMAMI LIFE · Local",
    "slug": "amami-life-local",
    "version": "0.3.1",
    "scheme": "amamilife-local",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    }
  }
}
