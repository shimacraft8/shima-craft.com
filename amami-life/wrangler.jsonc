{
  "name": "shima-craft-amami-life",
  "account_id": "42f69e35f08bb21dca5194467e2f59de",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"DEBUG_SOURCES":"0"},
  "assets": {"directory":"dist/public", "binding":"ASSETS", "run_worker_first":true, "html_handling":"none", "not_found_handling":"none"},
  "services": [{"binding":"SHIMA_ORIGIN","service":"shima-craft-com-production"}],
  "routes": [
    {"pattern":"shima-craft.com/*","zone_id":"cdfc2875eb9e0bf217159ec8be376373"},
    {"pattern":"www.shima-craft.com/*","zone_id":"cdfc2875eb9e0bf217159ec8be376373"}
  ]
}
